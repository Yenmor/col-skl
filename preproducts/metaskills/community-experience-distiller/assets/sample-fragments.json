      ],
      "transcript": [
        {
          "message_id": "post_course_2",
          "post_id": "post_course_2",
          "parent_id": null,
          "kind": "post",
          "author_id": "u_b",
          "author_name": "同学B",
          "created_at": "2026-04-05T08:30:00+08:00",
          "text": "有两门选修名字都很有趣，不知道怎么判断工作量。",
          "deleted": false,
          "sensitivity": [],
          "title": "课程名字看起来很水，实际会不会很难",
          "tags": [
            "选课",
            "课程负担"
          ],
          "role": "root_context"
        },
        {
          "message_id": "c_course_2",
          "post_id": "post_course_2",
          "parent_id": "post_course_2",
          "kind": "reply",
          "author_id": "u_lin",
          "author_name": "林学长",
          "created_at": "2026-04-05T09:10:00+08:00",
          "text": "课程名基本不能反映负担。至少问三件事：考核构成、每周作业、是否强制组队。最好找同一位老师最近一年的学生，因为老师和考核方式换了，旧经验就可能失效。",
          "deleted": false,
          "sensitivity": [],
          "role": "target"
        },
        {
          "message_id": "r_course_3",
          "post_id": "post_course_2",
          "parent_id": "c_course_2",
          "kind": "reply",
          "author_id": "u_b",
          "author_name": "同学B",
          "created_at": "2026-04-06T10:00:00+08:00",
          "text": "按这个方法问完，发现其中一门要每周汇报，我决定不选了。",
          "deleted": false,
          "sensitivity": [],
          "role": "response_to_target"
        }
      ],
