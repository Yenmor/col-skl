    {
      "fragment_id": "frag_0a25484db2",
      "thread_id": "post_course_2",
      "title": "课程名字看起来很水，实际会不会很难",
      "tags": [
        "选课",
        "课程负担"
      ],
      "target_message_ids": [
        "c_course_2"
      ],
      "source_message_ids": [
